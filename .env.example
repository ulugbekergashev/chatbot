# Nusxa oling: cp .env.example .env (lokal test uchun). Vercel'da esa
# Project → Settings → Environment Variables bo'limiga kiriting.

# ===== Sun'iy intellekt (kamida bittasi shart) =====
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free
# Ovozli xabarlar tili (Whisper). Bo'sh qoldirsangiz — avtomatik aniqlaydi
# TRANSCRIBE_LANGUAGE=uz

# ===== Doimiy xotira — Upstash Redis (Vercel → Storage/Marketplace → Upstash) =====
# Vercel integratsiyasi bularni o'zi qo'shadi. Busiz suhbatlar yo'qolib ketadi!
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Instagram / Facebook Messenger =====
VERIFY_TOKEN=mening_maxfiy_sozim_123
# "IG..." (Instagram Login) yoki "EAA..." (Facebook Page) token — turi avtomatik aniqlanadi
INSTAGRAM_ACCESS_TOKEN=
# Faqat Facebook Page token ("EAA...") ishlatilsa kerak
INSTAGRAM_PAGE_ID=
# Webhook imzosini tekshirish (tavsiya etiladi). Instagram Login bo'lsa — Instagram app secret
META_APP_SECRET=
# GRAPH_API_VERSION=v24.0

# ===== Telegram (boshqaruv paneli + shaxsiy chatlaringizga javob) =====
# @BotFather'dan olingan token. Business uchun: @BotFather → Bot Settings → Business Mode → ON
TELEGRAM_BOT_TOKEN=
# Istalgan tasodifiy so'z (faqat harf, raqam, _ va -)
TELEGRAM_WEBHOOK_SECRET=
# Sizning Telegram ID'ingiz (botga /id yozib bilib olasiz). Bir nechta bo'lsa — vergul bilan
TELEGRAM_ADMIN_IDS=

# ===== Bot xulqi =====
# Shaxsiy yordamchi kim nomidan gapiradi
OWNER_NAME=Ulug'bek
# Qisqacha siz haqingizda (yordamchi uchun kontekst)
OWNER_ABOUT=DentaCRM asoschisi
# Kanal → persona: sales (sotuv menejeri) yoki assistant (shaxsiy yordamchi)
# PERSONA_INSTAGRAM=sales
# PERSONA_TELEGRAM_BOT=sales
# PERSONA_TELEGRAM_BUSINESS=assistant
# Ketma-ket xabarlarni yig'ish uchun kutish (ms)
# DEBOUNCE_MS=3000
# Siz chatga o'zingiz yozsangiz, bot necha daqiqa jim tursin
# HUMAN_TAKEOVER_MINUTES=720
# HISTORY_LIMIT=30
# TIMEZONE=Asia/Tashkent
